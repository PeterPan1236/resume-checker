{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-checker",
  "main": "src/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
